---
import { getEntries, type CollectionEntry } from "astro:content";
import { withBase } from "astro-theme-university/url";

interface Props {
  teachers: CollectionEntry<"sessions">["data"]["teachers"] | CollectionEntry<"lectures">["data"]["teachers"];
}

const { teachers } = Astro.props;
// A session or lecture with no `teachers:` renders no team at all.
const people = teachers ? await getEntries(teachers) : [];

// Mirrors PeopleGrid's role -> display label map; the schema only ever
// gives us the raw lowercase enum value.
const roleLabels: Record<string, string> = {
  convenor: "Convenor",
  tutor: "Tutor",
  guest: "Guest lecturer",
  other: "Other",
};
---

{
  people.length > 0 && (
    <section aria-labelledby="teaching-team">
      <h2 id="teaching-team">Teaching team</h2>
      <ul>
        {people.map((person) => <li><a href={withBase(`/people/${person.id}/`)}>{person.data.title}</a> — {roleLabels[person.data.role] ?? person.data.role}</li>)}
      </ul>
    </section>
  )
}
